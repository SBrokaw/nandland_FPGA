# --- iCEcube2 Output Directories ---
# 1. Ignore the implementation directory contents
**/*_Implmnt/*
# 2. Allow Git to look into the subdirectories leading to the bin
!**/*_Implmnt/**/
# 4. Finally, explicitly allow the bin files
!**/*_Implmnt/**/*_bitmap.bin

# standard log files
stdout.log
stdout.log.bak

# --- Lattice Diamond / Programmer ---
# Diamond Programmer creates logs and temporary project files
*.xcf
*.bak
*.log
# Diamond project specific artifacts
.recovery/
*/.p_t/

# --- Synthesis & Tool Artifacts ---
# Synplify Pro (often used by iCEcube2) creates these
synlog.tcl
*.srr
*.srs
*.srm
*.sdc.bak
*.synprg
*.fse

# --- Bitstream & Binary Outputs ---
# Only exclude these if you prefer to build them fresh every time. 
# Usually, you don't want binaries in Git.
*.hex
*.bit

# --- OS/Editor Trash ---
.DS_Store
Thumbs.db
.vscode/
